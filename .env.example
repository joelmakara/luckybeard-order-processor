# Secrets are supplied via user-secrets in local development and via
# environment variables in deployed environments. Nothing here is committed
# with a real value; copy to .env (gitignored) or export directly.
# Double underscore maps to a configuration section separator.

DOTNET_ENVIRONMENT=Development

# Database
ConnectionStrings__Orders="Server=<host>;Database=Orders;User Id=<user>;Password=<password>;TrustServerCertificate=True;"

# SMTP credentials (host/port/from live in appsettings.json; credentials do not)
Smtp__Username=<username>
Smtp__Password=<password>
